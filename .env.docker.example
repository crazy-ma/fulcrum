APP_ENV=prod
# 必填:至少 32 位随机字符串(非开发环境使用示例值会拒绝启动)。生成:python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key
# 插件敏感配置使用独立 AES-GCM 主密钥，不能复用 SECRET_KEY，也没有默认值。
# 生成命令：python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ABOT_PLUGIN_SECRET_KEY=
LOG_LEVEL=INFO
MBS_DB_ROOT_PASSWORD=change-this-root-password
MBS_DB_USER=multi_bot_saas
MBS_DB_PASSWORD=change-this-database-password
AUTH_SEED_DEMO_USERS=false
# HTTPS 生产域名保持 true；仅通过 http://IP:8280 提供服务时必须显式改为 false，
# 否则浏览器不会在普通 HTTP 请求中回传平台和租户登录 Cookie。
AUTH_COOKIE_SECURE=true
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-this-password
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

# SQLite example
# DATABASE_URL=sqlite:////app/data/app.db

# MariaDB example
DATABASE_URL=mysql+pymysql://multi_bot_saas:change-this-database-password@mariadb:3306/multi_bot_saas?charset=utf8mb4
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_TIMEOUT_SECONDS=30

# Provider、开放接口和外部系统下载文件时使用的 SaaS 对外基址。
# PUBLIC_BASE_URL=https://saas.example.com

# 人工付款说明；二维码可配置为已部署的静态资源路径或受控 HTTPS 地址。
BILLING_PAYMENT_TITLE=Fulcrum 人工付款
BILLING_PAYMENT_INSTRUCTIONS=请完成转账后填写交易流水号并上传付款凭证。
# BILLING_PAYMENT_QR_IMAGE=/static/images/payment-qr.png
# BILLING_PAYMENT_BANK_DETAILS=开户行及账户信息
BILLING_PAYMENT_PROOF_MAX_BYTES=5242880

# AI 长期记忆服务(Hindsight)地址,应用容器与它在同一 docker 网络时用服务名;留空则不启用长期记忆(聊天照常)。
# 部署文件见 deploy/hindsight/。
# HINDSIGHT_URL=http://hindsight:8888
